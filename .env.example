# Copy to .env and set a private local PostgreSQL password. Never commit .env.
POSTGRES_USER=oceanwatch
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=oceanwatch
DATABASE_URL=postgresql+asyncpg://oceanwatch:replace_with_a_local_password@localhost:5432/oceanwatch

# Comma-separated React development origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Paths are relative to the repository root.
PREDICTION_MODEL_PATH=models/prediction/xgboost_model.pkl
MODEL_METADATA_PATH=models/prediction/model_metadata.json
ANOMALY_BASELINE_PATH=data/processed/anomaly_baselines.json
ALERT_THRESHOLD=61

# Optional credentials for explicit dataset downloads; never commit real values.
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password
CMEMS_USERNAME=your_cmems_username
CMEMS_PASSWORD=your_cmems_password
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
CDS_API_KEY=your_cds_uid:your_cds_api_key
