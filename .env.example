# =============================================================================
# OceanWatch AI — .env.example
# Copy to .env and fill in your real credentials. NEVER commit .env
# =============================================================================

# --- Database ---
POSTGRES_USER=oceanwatch
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=oceanwatch
DATABASE_URL=postgresql+asyncpg://oceanwatch:change_me_in_production@localhost:5432/oceanwatch

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Application ---
SECRET_KEY=change_me_in_production
ENVIRONMENT=development

# --- External API keys (never commit real values) ---
# NASA Earthdata
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# Copernicus Marine (CMEMS)
CMEMS_USERNAME=your_cmems_username
CMEMS_PASSWORD=your_cmems_password

# Copernicus CDS (ERA5)
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
CDS_API_KEY=your_cds_uid:your_cds_api_key

# --- Alerts ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_FROM_EMAIL=oceanwatch@yourdomain.com
